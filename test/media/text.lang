-- burnText gate programs (M2). Each entry takes (v : Video) (f : Font): the CLI
-- binds IN.mp4 then FONT.ttf (M2-R1). `many` has 65 entries (TEXT_LIMIT is 64).
def st : Font -> Style := fun (f : Font) => style f 32 16777215 10 20
def hello : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 5 9) "Hi") nil) v
def late : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 12 15) "Hi") nil) (trim (interval 10 29) v)
def early : Video -> Font -> Video := fun (v : Video) (f : Font) => trim (interval 10 29) (burnText (st f) (cons (pair (interval 12 15) "Hi") nil) v)
def around : Video -> Font -> Video := fun (v : Video) (f : Font) => pad (padSpec 200 160 20 20 1056816) (burnText (st f) (cons (pair (interval 5 9) "Hi") nil) (scale (res 160 120) v))
def odd : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (style f 32 1105952 11 7) (cons (pair (interval 0 49) "Hi") nil) v
def overlap : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (style f 32 16711680 20 30) (cons (pair (interval 10 19) "BB") nil) (burnText (st f) (cons (pair (interval 5 14) "AA") nil) (trim (interval 10 29) v))
def meta : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 0 49) "a:b,c'd\\e%f[g];h=i \"j\" 100%") nil) v
def utf8 : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (style f 24 16777215 10 20) (cons (pair (interval 0 49) "café €5") nil) v
def clipped : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (style f 32 16777215 400 20) (cons (pair (interval 0 49) "Hi") nil) v
def outside : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 40 45) "Hi") nil) (trim (interval 10 29) v)
def blank : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) nil v
def plain : Video -> Font -> Video := fun (v : Video) (f : Font) => idFilter v
def pairTrack : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 5 14) "AA") (cons (pair (interval 10 19) "BB") nil)) v
def twoSteps : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 10 19) "BB") nil) (burnText (st f) (cons (pair (interval 5 14) "AA") nil) v)
def apart : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 5 9) "AA") (cons (pair (interval 20 24) "BB") nil)) v
def apartR : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 20 24) "BB") (cons (pair (interval 5 9) "AA") nil)) v
def scaleText : Video -> Font -> Video := fun (v : Video) (f : Font) => scale (res 160 120) (burnText (st f) (cons (pair (interval 5 9) "Hi") nil) v)
def textScale : Video -> Font -> Video := fun (v : Video) (f : Font) => burnText (st f) (cons (pair (interval 5 9) "Hi") nil) (scale (res 160 120) v)
