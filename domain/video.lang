-- video-lang domain. The Makefile joins domain.lang and this file, in that
-- order, into build/domain-all.lang, so the names of domain.lang are in
-- scope here.
-- video-lang M1: a Filter maps a Video to a Video, for example
-- `fun (v : Video) => scale (res 160 120) v`. Resolution, Rect, PadSpec,
-- res, rect, padSpec, scale, crop and pad are core names of the kit.
-- compose and idFilter make a monoid: the laws hold by evaluation (D1).
def Filter : Type 0 := (v : Video) -> Video
def idFilter : Filter := fun (v : Video) => v
def compose : (f : Filter) -> (g : Filter) -> Filter :=
  fun (f : Filter) (g : Filter) => fun (v : Video) => f (g v)
def SubtitleTrack : Type 0 := List (Prod Interval Text)
