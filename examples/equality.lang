-- Formers F12 and F13: equality, transport and congruence.
def price : Nat := 1200
def cost : Nat := 1200
def same : Eq Nat price cost := refl
def back : Eq Nat cost price := symm same
def round : Eq Nat price price := trans same back
def moved : (P : (n : Nat) -> Type 0) -> (u : P price) -> P cost :=
  fun (P : (n : Nat) -> Type 0) (u : P price) => transport P same u
def bumped : Eq Nat (natAdd price 1) (natAdd cost 1) := cong (fun (n : Nat) => natAdd n 1) same
